<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml
    Manifiesto de la app "Induztek Protocolos".
    Aquí se declaran los permisos de los recursos nativos (cámara y ubicación)
    y la actividad principal. CameraX captura la foto y la guarda directamente
    en el almacenamiento de la app, por eso ya no se necesita FileProvider.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PERMISO DE CÁMARA: necesario para tomar la fotografía de evidencia de la prueba -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- PERMISOS DE UBICACIÓN: se piden juntos; con la gruesa basta como mínimo -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- La app puede usarse en equipos sin cámara: required=false evita que Play la filtre -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InduztekProtocolos">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.InduztekProtocolos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
